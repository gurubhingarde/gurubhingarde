  "reaction_plans": [
    {
      "id": "RP-001",
      "title": "Stop Production & Quarantine (Component Placement)",
      "steps": "1. Stop CPM immediately. 2. Quarantine parts from last in-control signal. 3. Notify QE + supervisor. 4. Investigate: gage calibration, tool offset, vision system focus. 5. Run 5-part pilot; all in spec = restart. Out of spec = repeat root cause.",
      "owner": "Quality Engineer",
      "escalation": "Immediate stop; escalate to Plant Quality Manager if > 10% nonconforming"
    },
    {
      "id": "RP-002",
      "title": "Reflow Oven Temperature Adjustment",
      "steps": "1. Trend visible in SPC chart (approaching limit). 2. Notify process engineer. 3. Adjust setpoint +/- 1-2°C. 4. Run 10 pilot boards; measure peak temp on all. 5. If centered, resume. If still drifting, investigate heater/sensor calibration.",
      "owner": "Process Engineer",
      "escalation": "If pilot fails, escalate to Stop & Investigate (RP-001)"
    },
    {
      "id": "RP-003",
      "title": "100% Inspection & Containment (Solder/ICT/FCT)",
      "steps": "1. Hold current lot (do not ship). 2. 100% inspect (AOI if solder; ICT/FCT retest if fail). 3. Accept = release; Reject = quarantine for MRB. 4. Root cause: gage calibration, process drift, material lot. 5. Corrective action if needed; resume normal control.",
      "owner": "Quality Engineer",
      "escalation": "MRB if > 10% nonconforming; notify customer if delay > 4 hours"
    },
    {
      "id": "RP-004",
      "title": "Firmware Version Mismatch Recovery",
      "steps": "1. Stop programming immediately if version mismatch detected. 2. Quarantine affected parts. 3. Verify programmer and software version on host PC. 4. Re-program with correct version. 5. Verify CRC = 0x12AB on 5 test parts. 6. 100% reprogram quarantined lot if needed.",
      "owner": "Manufacturing Engineer",
      "escalation": "Escalate to Quality Manager if > 50% of lot affected"
    },
    {
      "id": "RP-005",
      "title": "Poka-Yoke Connector Orientation Check",
      "steps": "1. Operator notices jam (connector cannot insert). 2. Supervisor assesses: wrong orientation vs. worn fixture. 3. If wrong orientation, reorient and try again. If worn fixture, switch to backup tooling. 4. Run 5 pilot parts; all pass = resume. 5. Schedule fixture maintenance if > 2 jams per shift.",
      "owner": "Supervisor/Manufacturing Engineer",
      "escalation": "If > 5 jams/shift from fixture wear, escalate maintenance priority"
    },
    {
      "id": "RP-006",
      "title": "Label Audit & Rework",
      "steps": "1. Operator finds label off-center or illegible. 2. Set aside and notify supervisor. 3. Rework: remove and reapply label. 4. Verify label now within spec. 5. Continue line; increase audit frequency to 100% next 50 parts.",
      "owner": "Supervisor",
      "escalation": "If > 10% of run affected, investigate label applicator calibration"
    },
    {
      "id": "RP-007",
      "title": "MES Traceability Scan Failure",
      "steps": "1. Barcode scan fails or MES rejects serial #. 2. Stop line and notify supervisor. 3. Verify part serial is correct and readable. 4. Re-scan; if still fail, manually verify serial in MES. 5. Quarantine affected parts; investigate data entry error or MES bug.",
      "owner": "Supervisor/IT Support",
      "escalation": "If MES down > 30 min, escalate to plant IT and quality manager"
    },
    {
      "id": "RP-008",
      "title": "Solder Paste Tack Time Failure",
      "steps": "1. Peel test shows tack time < 20 min. 2. Stop using current solder paste. 3. Open new paste spool; verify date code within 6 months. 4. Run tack test on new paste; must be > 20 min. 5. If OK, resume. If not, investigate paste supplier and storage conditions.",
      "owner": "Manufacturing Engineer",
      "escalation": "Escalate to Supplier Quality if paste issue confirmed (RP-003 template)"
    }
  ],
