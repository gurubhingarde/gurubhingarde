  "tools": [
    {
      "name": "MATLAB/Simulink",
      "vendor": "MathWorks",
      "version": "2024a",
      "usage": "Control law design, algorithm development, and HIL simulation for ESC SW requirements derivation",
      "tcl": "TCL3",
      "tcl_rationale": "MATLAB output directly influences safety-critical control algorithms; TCL3 requires full qualification or independent development",
      "qualification_status": "Planned: ISO 26262-8 Clause 11 qualification per MathWorks certificate"
    },
    {
      "name": "GitLab",
      "vendor": "GitLab Inc",
      "version": "Current SaaS",
      "usage": "Version control, configuration management, and change tracking for HW and SW",
      "tcl": "TCL1",
      "tcl_rationale": "Tool output (version history) does not influence safety decisions; manual code review and testing validate correctness independently",
      "qualification_status": "No qualification required (TCL1)"
    },
    {
      "name": "Polarion ALM",
      "vendor": "Siemens",
      "version": "2024.1",
      "usage": "Requirements management, traceability matrix, test case management, issue tracking for all safety artifacts",
      "tcl": "TCL2",
      "tcl_rationale": "Polarion output influences safety decision flow (traceability, requirements allocation); needs qualification or extensive manual verification",
      "qualification_status": "Planned: Qualification per IEC 62304 + ISO 26262-8 addendum"
    },
    {
      "name": "CANoe",
      "vendor": "Vector Informatik",
      "version": "16.0",
      "usage": "CAN bus simulation, message monitoring, and HIL testing for ESC system integration",
      "tcl": "TCL2",
      "tcl_rationale": "CANoe simulation results influence test design and integration decisions; manual verification of simulation against spec required",
      "qualification_status": "Qualification planned"
    },
    {
      "name": "MATLAB Test Manager",
      "vendor": "MathWorks",
      "usage": "Unit test automation and coverage analysis for SW verification",
      "tcl": "TCL3",
      "tcl_rationale": "Test coverage metrics influence release decision; TCL3 requires verification of tool correctness",
      "qualification_status": "Qualification planned as part of MATLAB suite"
    },
    {
      "name": "draw.io / Diagrams.net",
      "vendor": "JGraph Ltd",
      "version": "Web app",
      "usage": "Block diagrams, fault trees, interface diagrams for documentation",
      "tcl": "TCL1",
      "tcl_rationale": "Diagrams are documentation only; correctness verified by manual review, not tool output",
      "qualification_status": "No qualification required (TCL1)"
    },
    {
      "name": "MISRA C:2012 Compliance Checker (Parasoft)",
      "vendor": "Parasoft",
      "version": "2024.1",
      "usage": "Static code analysis and MISRA C:2012 rule enforcement for SW coding",
      "tcl": "TCL2",
      "tcl_rationale": "Tool findings influence code review and defect closure; requires verification that violations are not false negatives",
      "qualification_status": "Planned per ISO 26262-8"
    }
