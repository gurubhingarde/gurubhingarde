  "risks": [
    {
      "id": "R01",
      "description": "Supplier capacity for high-volume production (150k units/year)",
      "likelihood": "Medium",
      "impact": "High",
      "mitigation": "Early capacity planning, supplier qualification on dual-line production, SOP ramp agreement",
      "owner": "Lisa Johnson (Supplier Quality)"
    },
    {
      "id": "R02",
      "description": "Design complexity requiring multiple design iterations or prototype rebuilds",
      "likelihood": "Medium",
      "impact": "Medium",
      "mitigation": "Early design reviews (DR1/DR2), in-house prototype validation, simulation (SPICE) before breadboard",
      "owner": "David Martinez (Engineering Lead)"
    },
    {
      "id": "R03",
      "description": "Process capability not met during trial run (Cpk < 1.33)",
      "likelihood": "Low",
      "impact": "High",
      "mitigation": "Robust design (DFMEA mitigation), pre-trial run process optimization, backup process parameters defined",
      "owner": "Michael Rodriguez (Manufacturing)"
    },
    {
      "id": "R04",
      "description": "Customer requirement changes after Phase 1",
      "likelihood": "Medium",
      "impact": "High",
      "mitigation": "Change control process, impact analysis before approval, CSL/CTQ locked at Gate 1",
      "owner": "James Thompson (Program Manager)"
    },
    {
      "id": "R05",
      "description": "Key technical resource turnover (design or quality lead)",
      "likelihood": "Low",
      "impact": "High",
      "mitigation": "Cross-training, backup resource assigned, documentation of design decisions and rationale",
      "owner": "James Thompson (Program Manager)"
    },
    {
      "id": "R06",
      "description": "Supply chain delay for long-lead semiconductor components",
      "likelihood": "Medium",
      "impact": "Medium",
      "mitigation": "Early supplier orders, long-lead identified at Phase 1, inventory buffer at SOP",
